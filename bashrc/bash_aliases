if [ -d "$HOME/.bookmarks" ]; then
  # export CDPATH=".:$HOME/.bookmarks:"
  export CDPATH="$HOME/.bookmarks"
  # alias goto="cd -P"
  function goto() {
    pth=`cd $1`
    if [ -n "$pth" ];then
      cd -P $pth
    else
      ls $CDPATH
    fi
  }
  _goto()
  {
      local IFS=$'\n'
      COMPREPLY=( $( compgen -W "$(/bin/ls ~/.bookmarks)" -- ${COMP_WORDS[COMP_CWORD]}))
  } && complete -F _goto goto && complete -X '@*' -F _cd cd
fi

