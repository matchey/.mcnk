function lgrep(){
  ESC=$(printf '\033')
  echo "${ESC}[31mRED${ESC}[m"
  \grep -C 3 -i "${1}"  --group-separator="GREP_SEP_LINE" | sed "s/GREP_SEP_LINE/\n${ESC}[32m-=-=-=-=-=-=-=-=-=-${ESC}[m\n/g" | \less -p "${1}" -iXF +g
  # \less -p "$1" -NiXF # +"&$1"
}
